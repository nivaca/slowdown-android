<?xml version="1.0" encoding="utf-8"?>
<!-- La ventana: la onda arriba; debajo, los mandos; los marcadores y los bucles, al final. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        android:elevation="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <io.github.nivaca.slowdown.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/open_hint"
            android:textAppearance="?android:attr/textAppearanceMedium" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton android:id="@+id/to_start" style="@style/IconButton" android:src="@drawable/ic_start"
            android:contentDescription="@string/to_start" />
        <ImageButton android:id="@+id/back" style="@style/IconButton" android:src="@drawable/ic_back" />
        <ImageButton android:id="@+id/play" style="@style/IconButton" android:src="@drawable/ic_play"
            android:contentDescription="@string/play" android:scaleX="1.5" android:scaleY="1.5" />
        <ImageButton android:id="@+id/forward" style="@style/IconButton" android:src="@drawable/ic_forward" />
        <ImageButton android:id="@+id/to_end" style="@style/IconButton" android:src="@drawable/ic_end"
            android:contentDescription="@string/to_end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- La velocidad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/speed_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/normal_speed"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <Button android:id="@+id/speed_50" style="@style/SmallButton" android:text="50%" />
                <Button android:id="@+id/speed_75" style="@style/SmallButton" android:text="75%" />
                <Button android:id="@+id/speed_100" style="@style/SmallButton" android:text="100%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/slower" style="@style/IconButton" android:layout_width="48dp"
                    android:layout_weight="0" android:src="@drawable/ic_minus" android:contentDescription="@string/slower" />
                <SeekBar
                    android:id="@+id/speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="275" />
                <ImageButton android:id="@+id/faster" style="@style/IconButton" android:layout_width="48dp"
                    android:layout_weight="0" android:src="@drawable/ic_plus" android:contentDescription="@string/faster" />
            </LinearLayout>

            <!-- La altura: semitonos y cents -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pitch_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/original_pitch"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textAppearance="?android:attr/textAppearanceMedium" />

                <ImageButton android:id="@+id/lower" style="@style/IconButton" android:layout_width="48dp"
                    android:layout_weight="0" android:src="@drawable/ic_minus" android:contentDescription="@string/lower" />
                <ImageButton android:id="@+id/higher" style="@style/IconButton" android:layout_width="48dp"
                    android:layout_weight="0" android:src="@drawable/ic_plus" android:contentDescription="@string/higher" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="¢" />
                <SeekBar
                    android:id="@+id/cents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/cents"
                    android:max="50"
                    android:min="-50" />
                <View android:layout_width="48dp" android:layout_height="1dp" />
            </LinearLayout>

            <!-- La selección -->
            <TextView
                android:id="@+id/selection"
                style="@style/Heading"
                android:minLines="2"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/mark_a" style="@style/SmallButton" android:layout_width="0dp"
                    android:layout_weight="1" android:text="A" android:contentDescription="@string/selection_start" />
                <Button android:id="@+id/mark_b" style="@style/SmallButton" android:layout_width="0dp"
                    android:layout_weight="1" android:text="B" android:contentDescription="@string/selection_end" />
                <ImageButton android:id="@+id/repeat" style="@style/IconButton" android:layout_height="44dp"
                    android:src="@drawable/ic_repeat" android:contentDescription="@string/repeat" />
                <ImageButton android:id="@+id/save_loop" style="@style/IconButton" android:layout_height="44dp"
                    android:src="@drawable/ic_save_loop" android:contentDescription="@string/save_loop" />
                <ImageButton android:id="@+id/clear" style="@style/IconButton" android:layout_height="44dp"
                    android:src="@drawable/ic_clear" android:contentDescription="@string/clear_selection" />
            </LinearLayout>

            <!-- Los marcadores y los bucles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Heading" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/bookmarks" />
                <ImageButton android:id="@+id/add_bookmark" style="@style/IconButton" android:layout_width="48dp"
                    android:layout_weight="0" android:layout_height="44dp" android:src="@drawable/ic_bookmark_add"
                    android:contentDescription="@string/add_bookmark" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bookmark_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView android:id="@+id/loops_heading" style="@style/Heading" android:text="@string/loops" />

            <LinearLayout
                android:id="@+id/loop_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
