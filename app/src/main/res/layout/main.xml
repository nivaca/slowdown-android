<?xml version="1.0" encoding="utf-8"?>
<!-- La ventana, ordenada como la de py-slowdown: la onda arriba; debajo, la reproducción y el tiempo, luego las
     perillas (velocidad, volumen, altura) y la selección; al final, el panel de los marcadores y los bucles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        android:elevation="2dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <io.github.nivaca.slowdown.WaveformView
            android:id="@+id/waveform"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/open_hint"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>

    <!-- La reproducción, centrada, y el tiempo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <ImageButton android:id="@+id/to_start" style="@style/Tool" android:src="@drawable/ic_start"
            android:contentDescription="@string/to_start" />
        <ImageButton android:id="@+id/back" style="@style/Tool" android:src="@drawable/ic_back" />
        <ImageButton android:id="@+id/play" style="@style/Tool" android:layout_width="52dp" android:src="@drawable/ic_play"
            android:contentDescription="@string/play" android:scaleX="1.4" android:scaleY="1.4" />
        <ImageButton android:id="@+id/stop" style="@style/Tool" android:src="@drawable/ic_stop"
            android:contentDescription="@string/stop" />
        <ImageButton android:id="@+id/forward" style="@style/Tool" android:src="@drawable/ic_forward" />
        <ImageButton android:id="@+id/to_end" style="@style/Tool" android:src="@drawable/ic_end"
            android:contentDescription="@string/to_end" />
        <ImageButton android:id="@+id/repeat" style="@style/Tool" android:layout_marginStart="8dp"
            android:src="@drawable/ic_repeat" android:contentDescription="@string/repeat" />
        <ImageButton android:id="@+id/count" style="@style/Tool"
            android:src="@drawable/ic_count" android:contentDescription="@string/count_button" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/position_length"
            android:fontFamily="monospace"
            android:text="0:00.0 / 0:00.0"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAppearance="?android:attr/textAppearanceSmall" />
    </LinearLayout>

    <!-- La velocidad y el volumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView style="@style/KnobLabel" android:text="@string/speed" />
        <io.github.nivaca.slowdown.Knob android:id="@+id/speed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/normal_speed" style="@style/SmallButton" android:text="1×"
            android:contentDescription="@string/normal_speed" />
        <Button android:id="@+id/speeds" style="@style/SmallButton" android:text="@string/speeds" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/volume"
            android:src="@drawable/ic_volume" />
        <io.github.nivaca.slowdown.Knob android:id="@+id/volume" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <CheckBox
            android:id="@+id/boost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="13sp"
            android:text="@string/boost" />
    </LinearLayout>

    <!-- La altura: semitonos y cents; y la selección -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView style="@style/KnobLabel" android:text="@string/pitch" />
        <io.github.nivaca.slowdown.Knob android:id="@+id/semitones" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="4dp" />
        <io.github.nivaca.slowdown.Knob android:id="@+id/cents" android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/original_pitch" style="@style/SmallButton" android:text="ø"
            android:contentDescription="@string/original_pitch" />

        <Button android:id="@+id/mark_a" style="@style/SmallButton" android:layout_marginStart="14dp"
            android:text="A" android:contentDescription="@string/selection_start" />
        <Button android:id="@+id/mark_b" style="@style/SmallButton" android:text="B"
            android:contentDescription="@string/selection_end" />
        <ImageButton android:id="@+id/clear" style="@style/Tool" android:layout_width="40dp"
            android:src="@drawable/ic_clear" android:contentDescription="@string/clear_selection" />
    </LinearLayout>

    <TextView
        android:id="@+id/selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Los marcadores y los bucles, como el panel de py-slowdown: dos pestañas, una tabla y tres botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:text="@string/bookmarks_and_loops"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tab_bookmarks" style="@style/Tab" android:text="@string/bookmarks" />
            <TextView android:id="@+id/tab_loops" style="@style/Tab" android:text="@string/loops" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/table"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/table_header"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/header_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="@string/time"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/label"
                    android:textStyle="bold" />
            </LinearLayout>

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:choiceMode="singleChoice" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <Button android:id="@+id/add" style="@style/PanelButton" android:text="@string/add" />
            <Button android:id="@+id/remove" style="@style/PanelButton" android:text="@string/remove" />
            <Button android:id="@+id/export" style="@style/PanelButton" android:text="@string/export" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
